generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  RESCHEDULED
  COMPLETED
  NO_SHOW
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String
  passwordHash          String?
  timezone              String                 @default("Pacific/Auckland")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  eventTypes            EventType[]
  availabilitySchedules AvailabilitySchedule[]
  bookings              Booking[]              @relation("HostBookings")
}

model AvailabilitySchedule {
  id         String                 @id @default(cuid())
  userId     String
  name       String
  timezone   String                 @default("Pacific/Auckland")
  isDefault  Boolean                @default(false)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules      AvailabilityRule[]
  overrides  AvailabilityOverride[]
  eventTypes EventType[]

  @@index([userId])
}

model AvailabilityRule {
  id           String               @id @default(cuid())
  scheduleId   String
  weekday      Int
  startMinutes Int
  endMinutes   Int
  schedule     AvailabilitySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, weekday])
}

model AvailabilityOverride {
  id           String               @id @default(cuid())
  scheduleId   String
  date         String
  available    Boolean              @default(false)
  startMinutes Int?
  endMinutes   Int?
  schedule     AvailabilitySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, date])
}

model EventType {
  id                   String               @id @default(cuid())
  ownerId              String
  scheduleId           String
  name                 String
  slug                 String               @unique
  description          String?
  durationMinutes      Int                  @default(30)
  locationType         String               @default("online")
  locationConfig       Json?
  minimumNoticeMinutes Int                  @default(120)
  bufferBeforeMinutes  Int                  @default(0)
  bufferAfterMinutes   Int                  @default(0)
  bookingWindowDays    Int                  @default(60)
  slotIntervalMinutes  Int                  @default(30)
  active               Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  schedule             AvailabilitySchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  bookings             Booking[]

  @@index([ownerId])
  @@index([scheduleId])
}

model Booking {
  id                 String        @id @default(cuid())
  eventTypeId        String
  hostId             String
  guestName          String
  guestEmail         String
  guestTimezone      String
  startsAt           DateTime
  endsAt             DateTime
  status             BookingStatus @default(CONFIRMED)
  notes              String?
  cancellationReason String?
  rescheduledFromId  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  eventType          EventType     @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)
  host               User          @relation("HostBookings", fields: [hostId], references: [id], onDelete: Restrict)
  rescheduledFrom    Booking?      @relation("BookingReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo      Booking[]     @relation("BookingReschedule")

  @@unique([hostId, startsAt])
  @@index([eventTypeId, startsAt])
  @@index([hostId, startsAt, endsAt])
  @@index([guestEmail])
}
